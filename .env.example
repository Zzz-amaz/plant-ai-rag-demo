# 复制本文件为 .env 并填入真实值：.env 已被 .gitignore 忽略，切勿提交
# 两把 Key 缺一不可：缺 LLM 无法作答，缺 EMBEDDING 无法向量召回

# 对话模型（DeepSeek，兼容 OpenAI 协议）
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your_deepseek_api_key_here
LLM_THINKING_ENABLED=false

# 嵌入模型 + 重排（阿里云 DashScope 百炼；text-embedding-v4 为 1024 维）
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=your_dashscope_api_key_here
EMBEDDING_DIMENSION=1024
PAPER_RERANK_MODEL=qwen3-rerank

# 知识库路径（相对项目根目录）
CHROMA_PERSIST_DIR=data/chroma_db
PAPERS_DIR=data/papers
PAPER_RAG_ACTIVE_COLLECTION_NAME=plant_papers_pilot_full1979_v1

# 检索预算（一般无需修改）
PAPER_RAG_INITIAL_CHUNKS=10
PAPER_RAG_FALLBACK_CHUNKS=20
PAPER_RAG_LOCKED_PAPERS=3
PAPER_RAG_PAPER_RRF_CONSTANT=30
PAPER_RAG_PAPER_RERANK_WEIGHT=0.2
RAG_MAX_CONTEXT_CHARS=24000

# 设备名（敏感型号已统一脱敏）
DEMO_DEVICE_NAME=Device-A
